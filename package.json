{
  "name": "concretely",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive Vue 3 visualizers that make abstract programming concepts concrete — algorithms, data structures and more. Bilingual (FR/EN).",
  "author": "Alex Rovere",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts --fix",
    "format": "prettier --write src/",
    "clean": "rimraf dist node_modules/.vite"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/legacy-modes": "^6.5.3",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@lezer/highlight": "^1.2.3",
    "@ruby/3.4-wasm-wasi": "^2.9.3-2.9.4",
    "@ruby/wasm-wasi": "^2.9.3-2.9.4",
    "codemirror": "^6.0.2",
    "fuse.js": "^7.4.2",
    "sql.js": "^1.14.1",
    "vue": "^3.4.15"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.21.1",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.1",
    "terser": "^5.48.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-compression2": "^1.3.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
